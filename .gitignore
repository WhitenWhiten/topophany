# Build output
/bin/
/dist/
/.verify-build/
/.device-shots/
/topo
/topo.exe
*.exe
*.test
*.out

# Browser binaries and their local build cache are generated before deployment.
/site/public/data/*.wasm
/site/public/data/demo.build.json

# Local runtime state created by `topo init`, `serve` and `worker`
/demo/
/demo-web/
/topophany-demo/
/collector-data/
/worker-data/

# Credentials and key material — never commit
/auth.json
/credentials.json
/worker-credentials.json
*.pem
*.key
*.env

# Wrangler's local cache, written when deploying the homepage from site/
.wrangler/
/site/node_modules/
/internal/webui/node_modules/

# Go workspace
go.work
go.work.sum

# Python
__pycache__/
*.py[cod]
.venv/

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
