{
  "schema": 1,
  "project": "products-example",
  "applications": [
    {"id": "habitly", "name": "Habitly", "kind": "ios"},
    {"id": "snapmeal", "name": "Snapmeal", "kind": "ios"},
    {"id": "driftwood", "name": "Driftwood", "kind": "web"},
    {"id": "notebook", "name": "Notebook", "kind": "web"}
  ],
  "nodes": [
    {"id": "mac", "name": "MacBook", "kind": "host", "location": {"label": "Lisbon", "lat": 38.72, "lon": -9.14},
     "notes": "The laptop the products are built on. Its worker measures them as a user at home would, while it is awake."},
    {"id": "app", "name": "Hetzner Falkenstein", "kind": "vm", "provider": "hetzner", "location": {"label": "Falkenstein", "lat": 50.48, "lon": 12.37},
     "notes": "The one server run by hand: Snapmeal's API and the blog behind Cloudflare, with their databases. Its worker checks them on loopback, reads Supabase from a datacenter and reports the machine's own resources."},
    {"id": "app-db", "name": "Postgres container", "kind": "container", "parent": "app"},
    {"id": "cf", "name": "Cloudflare", "kind": "edge", "provider": "cloudflare",
     "notes": "Proxies Snapmeal's API and the blog, and runs Habitly's API as a Worker and both landing pages on Pages. An answer from it proves the edge only."},
    {"id": "vercel", "name": "Vercel", "kind": "edge", "provider": "vercel"},
    {"id": "supabase", "name": "Supabase", "kind": "platform", "provider": "supabase", "location": {"label": "Frankfurt", "lat": 50.11, "lon": 8.68}}
  ],
  "endpoints": [
    {"id": "habitly-api", "node": "cf", "address": "https://api.habitly.example/healthz", "network": "public"},
    {"id": "habitly-db", "node": "supabase", "address": "https://habitly.supabase.example/rest/v1/", "network": "public"},
    {"id": "habitly-site", "node": "cf", "address": "https://habitly.example/", "network": "public"},
    {"id": "snapmeal-api", "node": "app", "address": "https://api.snapmeal.example/healthz", "network": "public", "via": ["cf"]},
    {"id": "snapmeal-api-local", "node": "app", "address": "http://127.0.0.1:8080/healthz", "network": "loopback", "observer": "obs-app"},
    {"id": "snapmeal-db", "node": "app-db", "address": "127.0.0.1:5432", "network": "loopback", "observer": "obs-app"},
    {"id": "snapmeal-site", "node": "cf", "address": "https://snapmeal.example/", "network": "public"},
    {"id": "driftwood-web", "node": "vercel", "address": "https://driftwood.example/", "network": "public"},
    {"id": "driftwood-db", "node": "supabase", "address": "https://driftwood.supabase.example/rest/v1/", "network": "public"},
    {"id": "notebook-web", "node": "app", "address": "https://notebook.example/", "network": "public", "via": ["cf"]},
    {"id": "notebook-local", "node": "app", "address": "http://127.0.0.1:8081/", "network": "loopback", "observer": "obs-app"}
  ],
  "services": [
    {"id": "habitly-api", "name": "Habitly API", "application": "habitly", "node": "cf", "runtime": "workers", "endpoints": ["habitly-api"], "depends_on": ["habitly-db"],
     "notes": "The iOS app's API, a Cloudflare Worker. Its /healthz reads one row from the database, so a passing check proves the Worker and the query."},
    {"id": "habitly-db", "name": "Habitly DB", "application": "habitly", "node": "supabase", "runtime": "postgres", "endpoints": ["habitly-db"]},
    {"id": "habitly-site", "name": "Habitly Site", "application": "habitly", "node": "cf", "runtime": "pages", "endpoints": ["habitly-site"]},
    {"id": "snapmeal-api", "name": "Snapmeal API", "application": "snapmeal", "node": "app", "runtime": "container", "endpoints": ["snapmeal-api", "snapmeal-api-local"], "depends_on": ["snapmeal-db"],
     "runbook": "https://runbooks.snapmeal.example/api",
     "notes": "The iOS app's API on the Hetzner box behind Cloudflare. The public check proves the edge answered; the loopback check proves the API itself."},
    {"id": "snapmeal-db", "name": "Snapmeal DB", "application": "snapmeal", "node": "app-db", "runtime": "postgres", "endpoints": ["snapmeal-db"]},
    {"id": "snapmeal-site", "name": "Snapmeal Site", "application": "snapmeal", "node": "cf", "runtime": "pages", "endpoints": ["snapmeal-site"]},
    {"id": "driftwood-web", "name": "Driftwood", "application": "driftwood", "node": "vercel", "runtime": "functions", "endpoints": ["driftwood-web"], "depends_on": ["driftwood-db"]},
    {"id": "driftwood-db", "name": "Driftwood DB", "application": "driftwood", "node": "supabase", "runtime": "postgres", "endpoints": ["driftwood-db"]},
    {"id": "notebook-blog", "name": "Notebook Blog", "application": "notebook", "node": "app", "runtime": "container", "endpoints": ["notebook-web", "notebook-local"]}
  ],
  "observers": [
    {"id": "obs-mac", "name": "MacBook at home", "node": "mac", "context": "Lisbon, residential broadband", "stale_seconds": 180},
    {"id": "obs-app", "name": "Hetzner box", "node": "app", "context": "Falkenstein, datacenter", "stale_seconds": 180}
  ],
  "paths": [],
  "checks": [
    {"id": "habitly-api-home", "name": "Habitly API from home", "observer": "obs-mac", "endpoint": "habitly-api", "service": "habitly-api", "kind": "http", "availability_scope": "user_entry",
     "interval_seconds": 60, "timeout_seconds": 8, "stale_seconds": 180, "failure_threshold": 3, "recovery_threshold": 2, "max_duration_ms": 800, "tls_min_days": 14, "http": {"status": [200]}},
    {"id": "habitly-api-server", "name": "Habitly API from the server", "observer": "obs-app", "endpoint": "habitly-api", "service": "habitly-api", "kind": "http", "availability_scope": "remote",
     "interval_seconds": 60, "timeout_seconds": 8, "stale_seconds": 180, "failure_threshold": 3, "recovery_threshold": 2, "max_duration_ms": 800, "http": {"status": [200]}},
    {"id": "habitly-db-home", "name": "Habitly DB from home", "observer": "obs-mac", "endpoint": "habitly-db", "service": "habitly-db", "kind": "http", "availability_scope": "remote",
     "interval_seconds": 120, "timeout_seconds": 8, "stale_seconds": 360, "failure_threshold": 3, "recovery_threshold": 2,
     "http": {"status": [200], "request_header_envs": {"apikey": "HABITLY_SUPABASE_ANON_KEY"}},
     "notes": "Supabase's REST gateway answers 200 to the project's anon key. The key stays in the worker's environment."},
    {"id": "habitly-db-server", "name": "Habitly DB from the server", "observer": "obs-app", "endpoint": "habitly-db", "service": "habitly-db", "kind": "http", "availability_scope": "remote",
     "interval_seconds": 120, "timeout_seconds": 8, "stale_seconds": 360, "failure_threshold": 3, "recovery_threshold": 2,
     "http": {"status": [200], "request_header_envs": {"apikey": "HABITLY_SUPABASE_ANON_KEY"}}},
    {"id": "habitly-site-home", "name": "Habitly Site from home", "observer": "obs-mac", "endpoint": "habitly-site", "service": "habitly-site", "kind": "http", "availability_scope": "user_entry",
     "interval_seconds": 300, "timeout_seconds": 8, "stale_seconds": 900, "failure_threshold": 2, "recovery_threshold": 1, "tls_min_days": 14, "http": {"status": [200]}},
    {"id": "snapmeal-api-home", "name": "Snapmeal API through Cloudflare from home", "observer": "obs-mac", "endpoint": "snapmeal-api", "service": "snapmeal-api", "kind": "http", "availability_scope": "user_entry",
     "interval_seconds": 60, "timeout_seconds": 8, "stale_seconds": 180, "failure_threshold": 3, "recovery_threshold": 2, "max_duration_ms": 800, "tls_min_days": 14, "http": {"status": [200]}},
    {"id": "snapmeal-api-local", "name": "Snapmeal API on the box", "observer": "obs-app", "endpoint": "snapmeal-api-local", "service": "snapmeal-api", "kind": "http", "availability_scope": "local",
     "interval_seconds": 30, "timeout_seconds": 5, "stale_seconds": 90, "failure_threshold": 3, "recovery_threshold": 2, "http": {"status": [200]}},
    {"id": "snapmeal-db-local", "name": "Snapmeal DB on the box", "observer": "obs-app", "endpoint": "snapmeal-db", "service": "snapmeal-db", "kind": "tcp",
     "interval_seconds": 30, "timeout_seconds": 5, "stale_seconds": 90, "failure_threshold": 3, "recovery_threshold": 2},
    {"id": "snapmeal-site-home", "name": "Snapmeal Site from home", "observer": "obs-mac", "endpoint": "snapmeal-site", "service": "snapmeal-site", "kind": "http", "availability_scope": "user_entry",
     "interval_seconds": 300, "timeout_seconds": 8, "stale_seconds": 900, "failure_threshold": 2, "recovery_threshold": 1, "tls_min_days": 14, "http": {"status": [200]}},
    {"id": "driftwood-home", "name": "Driftwood from home", "observer": "obs-mac", "endpoint": "driftwood-web", "service": "driftwood-web", "kind": "http", "availability_scope": "user_entry",
     "interval_seconds": 60, "timeout_seconds": 8, "stale_seconds": 180, "failure_threshold": 3, "recovery_threshold": 2, "max_duration_ms": 1200, "tls_min_days": 14, "http": {"status": [200]}},
    {"id": "driftwood-server", "name": "Driftwood from the server", "observer": "obs-app", "endpoint": "driftwood-web", "service": "driftwood-web", "kind": "http", "availability_scope": "remote",
     "interval_seconds": 60, "timeout_seconds": 8, "stale_seconds": 180, "failure_threshold": 3, "recovery_threshold": 2, "max_duration_ms": 1200, "http": {"status": [200]}},
    {"id": "driftwood-db-server", "name": "Driftwood DB from the server", "observer": "obs-app", "endpoint": "driftwood-db", "service": "driftwood-db", "kind": "http", "availability_scope": "remote",
     "interval_seconds": 120, "timeout_seconds": 8, "stale_seconds": 360, "failure_threshold": 3, "recovery_threshold": 2,
     "http": {"status": [200], "request_header_envs": {"apikey": "DRIFTWOOD_SUPABASE_ANON_KEY"}}},
    {"id": "notebook-home", "name": "Notebook through Cloudflare from home", "observer": "obs-mac", "endpoint": "notebook-web", "service": "notebook-blog", "kind": "http", "availability_scope": "user_entry",
     "interval_seconds": 120, "timeout_seconds": 8, "stale_seconds": 360, "failure_threshold": 3, "recovery_threshold": 2, "tls_min_days": 14, "http": {"status": [200]}},
    {"id": "notebook-local", "name": "Notebook on the box", "observer": "obs-app", "endpoint": "notebook-local", "service": "notebook-blog", "kind": "http", "availability_scope": "local",
     "interval_seconds": 60, "timeout_seconds": 5, "stale_seconds": 180, "failure_threshold": 3, "recovery_threshold": 2, "http": {"status": [200]}},
    {"id": "app-host", "name": "Hetzner box resources", "observer": "obs-app", "kind": "host",
     "interval_seconds": 60, "timeout_seconds": 8, "stale_seconds": 180, "failure_threshold": 3, "recovery_threshold": 2,
     "host": {"disk_path": "/", "max_cpu_percent": 90, "max_memory_percent": 90, "max_disk_percent": 85}}
  ]
}
